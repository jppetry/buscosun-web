{
  "name": "buscosun-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-seo.mjs",
    "verify:seo": "node scripts/seo/verify-seo.mjs",
    "seo:logs": "node scripts/seo/parse-crawler-logs.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "qa:layers": "node scripts/qa-layers.mjs",
    "capture": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/capture-fixture.mjs",
    "fusion:train": "node --experimental-strip-types scripts/train-background.mjs",
    "fusion:loso": "node --experimental-strip-types scripts/verify-loso.mjs",
    "fusion:desroziers": "node --experimental-strip-types scripts/desroziers.mjs",
    "fusion:verify": "node --experimental-strip-types scripts/verify-oi.mjs && node --experimental-strip-types scripts/verify-background.mjs && node --experimental-strip-types scripts/verify-phase45.mjs && node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-modelsource.mjs",
    "verify:eps": "node --experimental-strip-types scripts/verify-eps.mjs",
    "verify:ch-eps": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-ch-eps.mjs",
    "verify:arome-fr": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-arome-fr.mjs",
    "verify:icon-eu": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-icon-eu.mjs",
    "verify:gfs-2d": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-gfs-2d.mjs",
    "verify:ifs": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-ifs.mjs ifs",
    "verify:aifs": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-ifs.mjs aifs-single",
    "verify:aifs-ens": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-ifs.mjs aifs-ens",
    "verify:icon-global": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-icon-global.mjs",
    "verify:aicon": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-aicon.mjs",
    "verify:arpege": "node --experimental-strip-types --import ./scripts/lib/register-ts.mjs scripts/verify-arpege.mjs",
    "fusion:status": "node --experimental-strip-types scripts/archive-status.mjs fixtures/",
    "fusion:gate": "node --experimental-strip-types scripts/phase3-gate.mjs fixtures/"
  },
  "dependencies": {
    "bz2": "^1.0.1",
    "bzip2-wasm": "^1.0.1",
    "jsfive": "^0.4.0",
    "maplibre-gl": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
